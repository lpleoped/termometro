{
  "name": "@termometro/desktop",
  "private": true,
  "version": "0.0.21",
  "description": "Termómetro de Equipo — diagnóstico de equipos",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "package:win": "npm run build && node scripts/package.cjs",
    "test": "npm run build && node --test tests/update-flow.test.cjs tests/package-runtime.test.cjs",
    "package:win:dir": "npm run build && node scripts/package.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "electron": "45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "~5.7.2"
  },
  "build": {
    "appId": "com.termometrodeequipo.desktop",
    "productName": "Termómetro",
    "executableName": "Termometro",
    "artifactName": "Termometro-de-Equipo-Setup-${version}.${ext}",
    "compression": "store",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "assets/icon.ico",
      "package.json",
      "!node_modules",
      "!../../node_modules"
    ],
    "extraResources": [
      {
        "from": "../api/dist",
        "to": "api/dist"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": ".runtime/node_modules",
        "to": "node_modules"
      },
      {
        "from": "../../packages/shared",
        "to": "node_modules/@termometro/shared"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer-firewall.nsh",
      "differentialPackage": false
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
