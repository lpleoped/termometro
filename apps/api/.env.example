PORT=3000
STORAGE_DRIVER=json
MONGO_URI=mongodb://localhost:27017/termometro-de-equipo
# Modo local sin MongoDB: STORAGE_DRIVER=json
# Directorio de datos opcional: TERMOMETRO_DATA_DIR=C:\\TermometroDeEquipo\\data
# Para que celulares de la misma Wi-Fi respondan: LOCAL_NETWORK=true
JWT_SECRET=
AI_CREDENTIAL_SECRET=
INTEGRATION_ENCRYPTION_KEY=
# Opcional: sugerencias de plan de acción
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4

# AI Analysis Limits (optional, defaults shown)
# AI_MAX_QUESTIONNAIRE_INPUT=24000  # Max chars for questionnaire generation input
# AI_MAX_QUALITATIVE_TEXT=4000      # Max chars per qualitative response
# AI_MAX_CONTEXT_CHARS=32000        # Max chars for team context in analysis
# AI_MAX_ANALYSES_PER_HOUR=20       # Rate limit for AI analysis requests per user
# AI_TIMEOUT_MS=180000              # Timeout in milliseconds for AI requests (180s default, increased for cold-start)
