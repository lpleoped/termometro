PORT=3000
STORAGE_DRIVER=json
MONGO_URI=mongodb://localhost:27017/termometro-de-equipo
# Modo local sin MongoDB: STORAGE_DRIVER=json
# Directorio de datos opcional: TERMOMETRO_DATA_DIR=C:\\TermometroDeEquipo\\data
# Para que celulares de la misma Wi-Fi respondan: LOCAL_NETWORK=true
JWT_SECRET=generar-un-secreto-aleatorio-de-al-menos-32-caracteres
AI_CREDENTIAL_SECRET=generar-otro-secreto-aleatorio-de-al-menos-32-caracteres
INTEGRATION_ENCRYPTION_KEY=generar-otro-secreto-aleatorio-de-al-menos-32-caracteres
